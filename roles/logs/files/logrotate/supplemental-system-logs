# These logs supplement the default RHEL log files.
# Rotate the additional log files created by
# /etc/rsyslog.d/10-supplemental-system-logs.conf.

/var/log/daemon.log
/var/log/kern.log
/var/log/syslog
{
  daily

  # retain seven rotated log files (approximately one week)
  rotate 7

  # rotate early if a log reaches this threshold:
  minsize 100M

  # skip rotation if log is empty or missing
  notifempty
  missingok

  # create new log files after rotation
  create 0640 root root

  # append the current date to rotated log filenames
  dateext

  # compress rotated logs on the following rotation
  compress
  delaycompress
  
  sharedscripts
  postrotate
    /usr/bin/systemctl -s HUP kill rsyslog.service >/dev/null 2>&1 || true
  endscript
}